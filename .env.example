# LLM selection agent, costume description agent, and image generation (OpenAI)
# OPENAI_API_KEY is required for the costume description agent even when IMAGE_BACKEND=gemini.
IMAGE_BACKEND=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Pipeline paths
OUTPUT_DIR=./outputs
LODGE_CODE_PATH=../Runs/LODGE
EDGE_CODE_PATH=../Runs/EDGE
LODGE_WEIGHTS_PATH=../Runs/LODGE/exp/Local_Module/FineDance_FineTuneV2_Local/checkpoints/epoch=299.ckpt
LODGE_GLOBAL_WEIGHTS_PATH=../Runs/LODGE/exp/Global_Module/FineDance_Global/checkpoints/epoch=2999.ckpt
EDGE_WEIGHTS_PATH=../Runs/EDGE/checkpoint.pt

# Optional: LODGE genre (FineDance label); default is neutral/pop-style Hiphop
LODGE_GENRE=Hiphop
AGENTLODGE_MIN_AUDIO_SECONDS=20
AGENTLODGE_MAX_EDGE_SLICES=7
AGENTLODGE_PARALLEL=0

# Optional warm multi-GPU routing over a shared mounted volume. Disabled by default.
# AGENTLODGE_DISTRIBUTED=1
# Optional staged rollout: jukebox.extract,lodge.generate,edge.generate,render.frames
# AGENTLODGE_DISTRIBUTED_CAPABILITIES=
# AGENTLODGE_WORKER_REGISTRY=/workspace/maestro-workers/registry.json
# AGENTLODGE_SHARED_ROOT=/workspace
# AGENTLODGE_DISTRIBUTED_STATE=/workspace/maestro-workers/_coordinator
# AGENTLODGE_DISTRIBUTED_TMP=/workspace/maestro-render-tmp
# AGENTLODGE_WORKER_HEARTBEAT_MAX_AGE=30
# AGENTLODGE_JUKEBOX_TIMEOUT=1800
# AGENTLODGE_GENERATION_TIMEOUT=1200
#
# Optional no-shared-volume transport for render.frames only. "filesystem"
# remains the default for all existing worker registry configurations.
# AGENTLODGE_DISTRIBUTED_TRANSPORT=http
# AGENTLODGE_HTTP_COORDINATOR_URL=https://coordinator.example/v1-prefix-if-needed
# AGENTLODGE_HTTP_TOKEN_FILE=/run/secrets/agentlodge-http-token
# AGENTLODGE_HTTP_COORDINATOR_SCRATCH=/var/lib/agentlodge/http-scratch
# Coordinator service:
# AGENTLODGE_HTTP_STATE_ROOT=/var/lib/agentlodge/coordinator
# AGENTLODGE_HTTP_ARTIFACT_ROOT=/var/lib/agentlodge/artifacts
# Worker container:
# AGENTLODGE_HTTP_WORKER_SCRATCH=/workspace/maestro-worker-scratch/render-0
# AGENTLODGE_HTTP_LEASE_SECONDS=30
# AGENTLODGE_HTTP_REQUEST_TIMEOUT=30
# AGENTLODGE_HTTP_MAX_ARTIFACT_BYTES=17179869184
#
# Per-process render worker placement. setup_pod.sh/setup_gen_pod.sh build the
# selector to the default path; one-visible-GPU containers do not load it.
# AGENTLODGE_GPU_INDEX=0
# AGENTLODGE_EGL_SELECTOR_SHIM=/workspace/.agentlodge/lib/libagentlodge_egl_cuda_device.so
# AGENTLODGE_WARM_POOL=1
# Default worker root: /tmp/agentlodge-render-<worker-id>
# AGENTLODGE_RENDER_LOCAL_BASE=/local-ssd/render-workers
# AGENTLODGE_RENDER_LOCAL_ROOT=/local-ssd/render-workers/render-g0-d0
# AGENTLODGE_RENDER_DAEMON_ROOT=/local-ssd/render-workers/render-g0-d0/daemon
# AGENTLODGE_WORKER_TMP=/local-ssd/render-workers/render-g0-d0/tmp
# Explicit shared-memory opt-in with aggregate reservation:
# AGENTLODGE_RENDER_USE_SHM=1
# AGENTLODGE_SHM_RESERVATION_BYTES=2147483648
# AGENTLODGE_SHM_HEADROOM_BYTES=4294967296
# AGENTLODGE_SHM_MAX_PERCENT=50
# AGENTLODGE_SHM_ROOT=/dev/shm
# Runtime ENOSPC fallback base (worker-specific directory is appended):
# AGENTLODGE_RENDER_FALLBACK_ROOT=/tmp
# AGENTLODGE_FFPROBE=/usr/bin/ffprobe

# Dance video rendering: "stick" (default, no extra assets) or "blender" (3D mesh in an
# EDGE-style studio: cyclorama backdrop, spotlight vignette, follow camera).
# The Blender path needs Blender installed. Pick the character with RENDER_CHARACTER:
#   "smplx" - smooth SMPL-X body; needs the licence-gated SMPL-X body model
#             (https://smpl-x.is.tue.mpg.de). SMPLX_MODEL_DIR must contain
#             smplx/SMPLX_NEUTRAL.npz. UV + texture are optional.
#   "ybot"  - EDGE's segmented Mixamo Y-Bot robot; needs EDGE's ybot.fbx (from EDGE's
#             SMPL-to-FBX/, https://github.com/Stanford-TML/EDGE). No SMPL-X model needed.
AGENTLODGE_RENDER_BACKEND=stick
AGENTLODGE_RENDER_CHARACTER=smplx
BLENDER_BIN=
SMPLX_MODEL_DIR=
SMPLX_UV_PATH=
SMPLX_TEXTURE_PATH=
YBOT_FBX_PATH=
# Robot base colour (r,g,b in 0-1) for the Y-Bot character.
AGENTLODGE_RENDER_COLOR=0.5,0.5,0.52
